# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> Data API / API Keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Number of digits in the emailed sign-in code. Must match
# Authentication -> Sign In / Providers -> Email -> "Email OTP Length".
# Supabase allows 6-10 and defaults to 6; anything invalid here falls back to 6.
VITE_OTP_LENGTH=6

# NOTE: no SMTP credential belongs in this file — the browser app never sends
# email. SMTP is configured in Supabase Dashboard -> Authentication -> Emails.
# See the README for the Gmail and Resend configurations.
